{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(npx expo *)",
      "Bash(adb version *)",
      "Bash(npx create-expo-app *)",
      "Bash(cp *)",
      "Bash(npm install *)",
      "Bash(pkill -f \"expo start\")",
      "Bash(echo \"Server starting in background \\(PID: $!\\)\")",
