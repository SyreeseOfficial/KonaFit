      "Bash(tee /tmp/expo-full.log)",
      "Bash(curl -s http://localhost:8081)",
      "Bash(pkill -9 -f \"expo start\")",
      "Bash(awk '{print $2}')",
      "Bash(xargs -r kill)",
      "Bash(eas *)"
    ]
  }
}
